---
// DragonDashboard.astro
// 更新：现代金融仪表盘UI、爆仓闪烁警报
---

<div class="dragon-widget">
  
  <!-- 龙的图片容器 -->
  <div class="dragon-wrapper" id="dragon-wrapper">
    <img src="/images/dragon_happy.png" class="dragon-img state-happy active" alt="Happy" />
    <img src="/images/dragon_nervous.png?v=2" class="dragon-img state-nervous" alt="Nervous" />
    <img src="/images/dragon_despair.png" class="dragon-img state-despair" alt="Despair" />
    <img src="/images/dragon_dead.png" class="dragon-img state-dead" alt="Dead" />
  </div>

  <!-- 数据看板 -->
  <div class="dashboard-board">
    <div class="board-content">
      <div class="board-row">
        <span class="label">Net Liq Value</span>
        <div class="value-box profit" id="val-net">$2,000,000</div>
      </div>
      <div class="board-row">
        <span class="label">Unrealized P&L</span>
        <div class="value-box profit" id="val-unrealized">+$1,000,000</div>
      </div>
      <div class="board-row">
        <span class="label">Realized P&L</span>
        <div class="value-box neutral" id="val-realized">$0</div>
      </div>
    </div>
    
    <!-- 爆仓警报文本 -->
    <div class="liquidation-alert" id="liq-alert">
      ⚠️ LIQUIDATED
    </div>
  </div>
</div>

<style>
  .dragon-widget {
    position: fixed;
    bottom: 40px;
    right: 30px;
    width: 260px;
    z-index: 900;
    font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
  }

  .dragon-wrapper {
    width: 250px; 
    height: 250px; 
    margin: 0 auto -82px auto; /* 确保爪子搭在板子上 */
    position: relative;
    z-index: 5; 
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .dragon-img {
    position: absolute; bottom: 0; left: 0; width: 100%; height: 100%;
    object-fit: contain; opacity: 0; transform: scale(0.9);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .dragon-img.active { opacity: 1; transform: scale(1); }

  /* --- 升级版的看板 UI --- */
  .dashboard-board {
    background: rgba(15, 18, 22, 0.95); /* 更深邃的黑 */
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-top: 4px solid #2962ff; /* 顶部科技蓝亮线 */
    border-radius: 12px;
    padding: 20px 15px;
    position: relative;
    z-index: 10;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.05);
  }

  .board-row {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 12px; font-size: 0.85rem; color: #8ba1b5; font-weight: 500;
  }
  .board-row:last-child { margin-bottom: 0; }

  .value-box {
    background: rgba(0, 0, 0, 0.5);
    padding: 4px 8px;
    border-radius: 4px;
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.95rem; font-weight: bold;
    min-width: 90px; text-align: right;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .profit { color: #00e676; text-shadow: 0 0 8px rgba(0, 230, 118, 0.2); } 
  .loss { color: #ff1744; text-shadow: 0 0 8px rgba(255, 23, 68, 0.2); }   
  .neutral { color: #e0e0e0; }

  /* --- 爆仓警报动画 --- */
  .liquidation-alert {
    position: absolute;
    bottom: -40px;
    left: 0; right: 0;
    text-align: center;
    color: #ff1744;
    font-size: 1.2rem;
    font-weight: 900;
    letter-spacing: 2px;
    opacity: 0;
    pointer-events: none;
  }
  .liquidation-alert.active {
    animation: flashAlert 1s infinite alternate;
  }

  @keyframes flashAlert {
    0% { opacity: 0.2; text-shadow: none; transform: scale(0.95); }
    100% { opacity: 1; text-shadow: 0 0 15px #ff1744, 0 0 30px #ff1744; transform: scale(1); }
  }

  .dragon-wrapper.fallen {
    transform: translateY(180px) rotate(180deg); 
    opacity: 0; 
    transition: transform 0.8s ease-in, opacity 0.5s 0.3s;
  }
</style>

<script>
  const wrapper = document.getElementById('dragon-wrapper');
  const alertText = document.getElementById('liq-alert');
  
  const imgHappy = wrapper.querySelector('.state-happy');
  const imgNervous = wrapper.querySelector('.state-nervous');
  const imgDespair = wrapper.querySelector('.state-despair');
  const imgDead = wrapper.querySelector('.state-dead');

  const elNet = document.getElementById('val-net');
  const elUnreal = document.getElementById('val-unrealized');
  const elReal = document.getElementById('val-realized');

  const CAPITAL = 1000000; 
  const LIQ_THRESHOLD = 0.9;

  window.addEventListener('scroll', () => {
    const scrollY = window.scrollY;
    const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
    let progress = 0;
    if (maxScroll > 0) progress = scrollY / maxScroll;

    wrapper.classList.remove('fallen');
    alertText.classList.remove('active');
    [imgHappy, imgNervous, imgDespair, imgDead].forEach(img => img.classList.remove('active'));

    if (progress < LIQ_THRESHOLD) {
        const range = 2 * CAPITAL;
        let currentPnL = CAPITAL - (progress / LIQ_THRESHOLD) * range;
        if (Math.abs(currentPnL) < 100) currentPnL = 0;

        let netVal = CAPITAL + currentPnL;
        let unrealized = currentPnL;
        let realized = 0;

        updateDisplay(netVal, unrealized, realized);

        if (progress <= 0.3) {
            imgHappy.classList.add('active'); 
        } else if (progress > 0.3 && progress <= 0.6) {
            imgNervous.classList.add('active'); 
        } else {
            imgDespair.classList.add('active'); 
        }
    } else {
        imgDead.classList.add('active'); 
        wrapper.classList.add('fallen'); 
        alertText.classList.add('active'); // 触发红色闪烁警报

        elNet.innerText = "$0"; elNet.className = "value-box loss"; 
        elUnreal.innerText = "$0"; elUnreal.className = "value-box loss"; 
        elReal.innerText = "-$1,000,000"; elReal.className = "value-box loss"; 
    }
  });

  function updateDisplay(net, unreal, real) {
    elNet.innerText = "$" + formatMoney(net);
    elNet.className = "value-box " + (net >= CAPITAL ? "profit" : "loss");

    elUnreal.innerText = (unreal > 0 ? "+" : (unreal < 0 ? "-" : "")) + "$" + formatMoney(Math.abs(unreal));
    elUnreal.className = "value-box " + (unreal > 0 ? "profit" : (unreal < 0 ? "loss" : "neutral"));

    elReal.innerText = "$" + formatMoney(real);
    elReal.className = "value-box neutral";
  }

  function formatMoney(num) {
    return Math.round(num).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
  }
</script>