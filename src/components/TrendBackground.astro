---
// TrendBackground.astro
// 修复：关闭K线时，同时隐藏成本线和强平线，只保留网格
---

<canvas id="trading-canvas"></canvas>

<style>
  #trading-canvas {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1;
    transition: background-color 0.3s ease;
  }
</style>

<script>
  const canvas = document.getElementById('trading-canvas');
  const ctx = canvas.getContext('2d');

  let state = { theme: 'dark', showChart: true };

  const CONFIG = {
    candleWidth: 10,
    candleSpacing: 4,
    speed: 500,
    costLineY: 0.5,
    liqLineY: 0.9,
    
    dark: { bg: '#0b0e11', grid: '#1e2329', up: '#00c853', down: '#ff3d00', lineCost: '#fdd835', lineLiq: '#ff1744' },
    light: { bg: '#f0f2f5', grid: '#e1e3e6', up: '#00796b', down: '#d32f2f', lineCost: '#fbc02d', lineLiq: '#d50000' }
  };

  let candles = [];
  let width, height;
  let lastTime = 0;

  window.addEventListener('update-canvas', (e: CustomEvent) => {
    state = { ...state, ...e.detail };
    drawScene();
  });

  function resize() {
    width = window.innerWidth;
    height = window.innerHeight;
    canvas.width = width;
    canvas.height = height;
    if (candles.length === 0) fillInitialData();
  }

  function fillInitialData() {
      const totalCandles = Math.ceil(width / (CONFIG.candleWidth + CONFIG.candleSpacing));
      let tempY = height * 0.1;
      for (let i = 0; i < totalCandles; i++) {
          const open = tempY;
          const close = tempY + (Math.random() - 0.5) * 10;
          candles.push({ open, close, high: Math.min(open, close)-5, low: Math.max(open, close)+5 });
          tempY = close;
      }
  }

  function generateCandle() {
      const scrollY = window.scrollY;
      const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
      let scrollPercent = 0;
      if (maxScroll > 0) scrollPercent = scrollY / maxScroll;

      const targetY = (height * 0.1) + (scrollPercent * (height * 0.8));
      const noise = (Math.random() - 0.5) * 40; 
      const currentPrice = targetY + noise;

      const lastCandle = candles[candles.length - 1];
      const open = lastCandle ? lastCandle.close : currentPrice;
      const close = currentPrice;

      const bodyMin = Math.min(open, close);
      const bodyMax = Math.max(open, close);
      
      return {
          open, close,
          high: bodyMin - Math.random() * 20,
          low: bodyMax + Math.random() * 20
      };
  }

  function drawScene() {
    const colors = state.theme === 'dark' ? CONFIG.dark : CONFIG.light;

    // 1. 背景
    ctx.fillStyle = colors.bg;
    ctx.fillRect(0, 0, width, height);

    // 2. 网格 (始终显示)
    ctx.lineWidth = 1;
    ctx.strokeStyle = colors.grid;
    ctx.beginPath();
    for (let x = width; x >= 0; x -= 30) { ctx.moveTo(x, 0); ctx.lineTo(x, height); }
    for (let y = 0; y < height; y += 30) { ctx.moveTo(0, y); ctx.lineTo(width, y); }
    ctx.stroke();

    // 3. K线及辅助线 (由开关控制)
    if (!state.showChart) return; // <--- 关键修改：在这里拦截，不画后面的辅助线和K线

    // 辅助线：成本线
    ctx.lineWidth = 2;
    ctx.setLineDash([5, 5]);
    ctx.strokeStyle = colors.lineCost;
    ctx.beginPath();
    ctx.moveTo(0, height * CONFIG.costLineY);
    ctx.lineTo(width, height * CONFIG.costLineY);
    ctx.stroke();
    ctx.fillStyle = colors.lineCost;
    ctx.font = '12px sans-serif';
    ctx.fillText("AVG COST", 10, height * CONFIG.costLineY - 5);

    // 辅助线：强平线
    ctx.strokeStyle = colors.lineLiq;
    ctx.beginPath();
    ctx.moveTo(0, height * CONFIG.liqLineY);
    ctx.lineTo(width, height * CONFIG.liqLineY);
    ctx.stroke();
    ctx.fillStyle = colors.lineLiq;
    ctx.fillText("LIQUIDATION", 10, height * CONFIG.liqLineY - 5);

    ctx.setLineDash([]); 

    // 绘制蜡烛
    const candleTotalWidth = CONFIG.candleWidth + CONFIG.candleSpacing;
    for (let i = 0; i < candles.length; i++) {
        const indexFromRight = candles.length - 1 - i;
        const x = width - (indexFromRight * candleTotalWidth) - (candleTotalWidth);
        if (x < -candleTotalWidth) continue;

        const c = candles[i];
        const isUp = c.close < c.open;
        const color = isUp ? colors.up : colors.down;
        
        ctx.fillStyle = color;
        ctx.strokeStyle = color;
        
        ctx.beginPath();
        ctx.moveTo(x + CONFIG.candleWidth/2, c.high);
        ctx.lineTo(x + CONFIG.candleWidth/2, c.low);
        ctx.stroke();

        const bodyTop = Math.min(c.open, c.close);
        const bodyHeight = Math.max(Math.abs(c.close - c.open), 1); 
        ctx.fillRect(x, bodyTop, CONFIG.candleWidth, bodyHeight);
    }
  }

  function animate(timestamp) {
    if (timestamp - lastTime > CONFIG.speed) {
        const newCandle = generateCandle();
        candles.push(newCandle);
        if (candles.length > (width / CONFIG.candleWidth) * 1.5) {
            candles.shift();
        }
        lastTime = timestamp;
    }
    drawScene();
    requestAnimationFrame(animate);
  }

  window.addEventListener('resize', resize);
  resize();
  requestAnimationFrame(animate);
</script>