---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

// 获取所有博客并排序
const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);
---

<BaseLayout title="历史记录">
  
  <!-- 页面头部 -->
  <div class="card">
    <h1 style="margin-top: 0; color: var(--text-main);">📜 历史记录 (All Records)</h1>
    <p>这里记录了所有的日常复盘、思考与想法。</p>
    <a href="/" style="font-size:0.9rem; color: var(--highlight); text-decoration: none;">← 返回首页</a>
  </div>

  <!-- 文章瀑布流 -->
  <div class="card">
    <div class="feed-container">
      {sortedPosts.map(async (post) => {
        const { Content } = await render(post);
        return (
          <div class="feed-post">
            <div class="post-header">
              <a href={`/blog/${post.id}`} class="post-title">{post.data.title}</a>
              <span class="post-date">{post.data.pubDate.toLocaleDateString('zh-CN')}</span>
            </div>
            <div class="post-body prose">
              <Content />
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <!-- 页面专属样式（从首页搬过来的排版） -->
  <style>
    .feed-container { display: flex; flex-direction: column; }
    .feed-post { margin-bottom: 30px; padding-bottom: 30px; border-bottom: 1px dashed rgba(255,255,255,0.1); }
    .feed-post:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
    
    .post-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 15px; }
    .post-title { margin: 0; font-size: 1.4rem; color: var(--highlight); font-weight: bold; text-decoration: none; }
    .post-title:hover { text-decoration: underline; }
    .post-date { font-size: 0.85rem; color: var(--text-sub); font-family: monospace; }
    
    .prose { font-size: 1rem; line-height: 1.8; color: var(--text-sub); }
    .prose p { margin-top: 0; margin-bottom: 1em; }
    .prose strong { color: var(--text-main); font-weight: 600; }
    .prose ul { padding-left: 20px; margin-top: 0; }
    .prose li { margin-bottom: 5px; }
  </style>

</BaseLayout>