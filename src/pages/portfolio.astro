---
import BaseLayout from '../layouts/BaseLayout.astro';
// 如果你之前创建了利润图表组件，取消下面这行的注释
// import ProfitChart from '../components/ProfitChart.astro';
---

<BaseLayout title="交易战绩">
  <!-- 1. 头部标题 -->
  <div class="card">
    <h1 style="margin-top:0;">📊 交易战绩 (Trading Portfolio)</h1>
    <p>记录每一笔交易。</p>
  </div>

  <!-- 2. 新增：核心交易指标 (KPI Data Cards) -->
  <div class="kpi-grid">
    <div class="kpi-card">
      <div class="kpi-label">历史胜率 (Win Rate)</div>
      <div class="kpi-value">66%</div>
      <div class="kpi-sub">9 盈利 / 6 亏损</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">最佳交易 (Best Trade)</div>
      <div class="kpi-value profit">+21.15%</div>
      <div class="kpi-sub">AAL</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">最差交易 (Worst Trade)</div>
      <div class="kpi-value loss">-18.51%</div>
      <div class="kpi-sub">HOOD</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">最大回撤 (Max Drawdown)</div>
      <div class="kpi-value loss">-12.4%</div>
      <div class="kpi-sub">Estimated</div>
    </div>
  </div>

  <!-- 如果有图表，放在这里 -->
  <!-- 
  <div class="card">
    <h3 style="color:var(--text-sub); margin-bottom:15px; margin-top:0;">📈 收益曲线 (Equity Curve)</h3>
    <ProfitChart />
  </div>
  -->

  <!-- 3. 持仓中 -->
  <div class="card">
    <h3 style="color:var(--text-sub); margin-bottom:10px; margin-top:0;">⏳ 持仓中 (Holding)</h3>
    <div style="overflow-x: auto;">
      <table style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead><tr style="border-bottom: 1px solid var(--card-border);"><th style="padding:12px; color:var(--text-sub);">代码</th><th style="padding:12px; color:var(--text-sub);">交易时间</th><th style="padding:12px; color:var(--text-sub);">当前状态</th></tr></thead>
        <tbody>
          <tr style="border-bottom: 1px solid var(--card-border);">
            <td style="padding:12px;"><b>UVIX</b></td><td style="padding:12px;">2026.03</td><td style="padding:12px; color: var(--text-sub);">持有</td>
          </tr>
          <td style="padding:12px;"><b>NVO</b></td><td style="padding:12px;">2026.02</td><td style="padding:12px; color: var(--text-sub);">持有</td>
        </tr>
          <tr style="border-bottom: 1px solid var(--card-border);">
            <td style="padding:12px;"><b>SQQQ</b></td><td style="padding:12px;">2026.03</td><td style="padding:12px; color: var(--text-sub);">持有</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- 资产圆环图与收益统计 -->
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px; margin-top: 20px; padding: 25px; background: rgba(0,0,0,0.03); border-radius: 12px; border: 1px solid var(--card-border);">
      <div style="display: flex; align-items: center; gap: 30px;">
        <div style="width: 110px; height: 110px; border-radius: 50%; background: conic-gradient(var(--highlight) 0% 97.02%, var(--profit) 97.02% 99.10%, #ff9800 99.10% 100%); position: relative; display: flex; justify-content: center; align-items: center; box-shadow: 0 0 15px rgba(0,0,0,0.5);">
          <div style="position: absolute; width: 75px; height: 75px; background: var(--card-bg); border-radius: 50%;"></div>
          <div style="position: absolute; z-index: 1; font-size: 0.75rem; color: var(--text-sub); font-weight: bold; text-align: center; letter-spacing: 1px;">ASSETS</div>
        </div>
        <div style="display: flex; flex-direction: column; gap: 12px;">
          <div style="display: flex; align-items: center; gap: 8px; font-size: 0.95rem; color: var(--text-main);"><div style="width: 12px; height: 12px; border-radius: 3px; background: var(--highlight);"></div><div><b>CASH</b>: 97.22%</div></div>
          <div style="display: flex; align-items: center; gap: 8px; font-size: 0.95rem; color: var(--text-main);"><div style="width: 12px; height: 12px; border-radius: 3px; background: var(--profit);"></div><div><b>NVO</b>: 1.79%</div></div>
          <div style="display: flex; align-items: center; gap: 8px; font-size: 0.95rem; color: var(--text-main);"><div style="width: 12px; height: 12px; border-radius: 3px; background: #ff9800;"></div><div><b>SQQQ</b>: 0.87%</div></div>
        </div>
      </div>
      <div style="display: flex; flex-direction: column; gap: 15px; padding-left: 25px; border-left: 1px dashed var(--card-border);">
        <div><div style="font-size: 0.85rem; color: var(--text-sub); margin-bottom: 4px;">绝对收益率 (Absolute)</div><div style="font-size: 1.5rem; font-weight: 900; font-family: monospace; color: var(--profit);">+18.26%</div></div>
        <div><div style="font-size: 0.85rem; color: var(--text-sub); margin-bottom: 4px;">年化收益率 (XIRR)</div><div style="font-size: 1.5rem; font-weight: 900; font-family: monospace; color: var(--profit);">+30.50%</div></div>
      </div>
    </div>
  </div>

  <!-- 4. 已平仓 -->
  <div class="card">
    <h3 style="color:var(--text-sub); margin-bottom:10px; margin-top:0;">🏁 已平仓 (Closed)</h3>
    <div style="overflow-x: auto;">
      <table style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead><tr style="border-bottom: 1px solid var(--card-border);"><th style="padding:12px; color:var(--text-sub);">代码</th><th style="padding:12px; color:var(--text-sub);">盈亏 %</th><th style="padding:12px; color:var(--text-sub);">状态</th></tr></thead>
        <tbody>
          <tr style="border-bottom: 1px dashed var(--card-border);"><td style="padding:12px;"><b>AAL</b></td><td style="padding:12px; color: var(--profit); font-weight:bold;">+21.15%</td><td style="padding:12px; color:var(--text-sub);">已清仓</td></tr>
          <tr style="border-bottom: 1px dashed var(--card-border);"><td style="padding:12px;"><b>GOOGL</b></td><td style="padding:12px; color: var(--profit); font-weight:bold;">+18.09%</td><td style="padding:12px; color:var(--text-sub);">已清仓</td></tr>
          <tr style="border-bottom: 1px dashed var(--card-border);"><td style="padding:12px;"><b>OXY</b></td><td style="padding:12px; color: var(--profit); font-weight:bold;">+16.53%</td><td style="padding:12px; color:var(--text-sub);">已清仓</td></tr>
          <tr style="border-bottom: 1px dashed var(--card-border);"><td style="padding:12px;"><b>TSLA</b></td><td style="padding:12px; color: var(--profit); font-weight:bold;">+8.47%</td><td style="padding:12px; color:var(--text-sub);">已清仓</td></tr>
          <tr style="border-bottom: 1px dashed var(--card-border);"><td style="padding:12px;"><b>UNH</b></td><td style="padding:12px; color: var(--profit); font-weight:bold;">+0.84%</td><td style="padding:12px; color:var(--text-sub);">已清仓</td></tr>
          <tr style="border-bottom: 1px dashed var(--card-border);"><td style="padding:12px;"><b>PSQ</b></td><td style="padding:12px; color: var(--profit); font-weight:bold;">+0.25%</td><td style="padding:12px; color:var(--text-sub);">已清仓</td></tr>
          <tr style="border-bottom: 1px dashed var(--card-border);"><td style="padding:12px;"><b>NKE</b></td><td style="padding:12px; color: var(--loss); font-weight:bold;">-5.81%</td><td style="padding:12px; color:var(--text-sub);">已清仓</td></tr>
          <tr style="border-bottom: 1px dashed var(--card-border);"><td style="padding:12px;"><b>DJT</b></td><td style="padding:12px; color: var(--loss); font-weight:bold;">-8.29%</td><td style="padding:12px; color:var(--text-sub);">已清仓</td></tr>
          <tr style="border-bottom: 1px dashed var(--card-border);"><td style="padding:12px;"><b>XYZ</b></td><td style="padding:12px; color: var(--loss); font-weight:bold;">-8.80%</td><td style="padding:12px; color:var(--text-sub);">已清仓</td></tr>
          <tr><td style="padding:12px;"><b>UVIX</b></td><td style="padding:12px; color: var(--loss); font-weight:bold;">-15.77%</td><td style="padding:12px; color:var(--text-sub);">已清仓</td></tr>
          <tr><td style="padding:12px;"><b>HOOD</b></td><td style="padding:12px; color: var(--loss); font-weight:bold;">-18.51%</td><td style="padding:12px; color:var(--text-sub);">已清仓</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- 5. 新增：交易铁律 -->
  <div class="card" style="border-left: 4px solid var(--loss); background: rgba(255, 61, 0, 0.05);">
    <h3 style="color:var(--loss); margin-top:0; margin-bottom:10px;"><i class="fas fa-exclamation-triangle"></i> 交易原则 (Rules)</h3>
    <ul style="color: var(--text-main); font-size: 0.95rem; line-height: 1.8; padding-left: 20px; margin: 0;">
      <li>ABC.</li>
      <li>Cut losers early, let winners run.</li>
      <li>When you have tremendous conviction on a trade, you have to go for the jugular. It takes courage to be a pig. As far as I'm concerned, when you're right on something, you can't be too big.</li>
    </ul>
  </div>

  <style>
    /* KPI 卡片网格布局 */
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 20px;
      margin-bottom: 20px;
    }
    .kpi-card {
      background: var(--card-bg);
      backdrop-filter: blur(10px);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      padding: 20px;
      text-align: center;
      transition: transform 0.3s;
    }
    .kpi-card:hover {
      transform: translateY(-5px);
      border-color: var(--highlight);
    }
    .kpi-label {
      font-size: 0.85rem;
      color: var(--text-sub);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 10px;
    }
    .kpi-value {
      font-size: 2rem;
      font-weight: 900;
      font-family: 'Courier New', Courier, monospace;
      margin-bottom: 5px;
      color: var(--text-main);
    }
    .kpi-sub {
      font-size: 0.8rem;
      color: var(--text-sub);
    }
    .profit { color: var(--profit); }
    .loss { color: var(--loss); }
  </style>

</BaseLayout>