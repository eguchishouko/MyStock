---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="交易战绩">
  <div class="card">
    <h1 style="margin-top:0;">📊 交易战绩 (Trading Portfolio)</h1>
    <p>记录每一笔交易。</p>
  </div>

  <div class="card">
    <h3 style="color:var(--text-sub); margin-bottom:10px;">⏳ 持仓中 (Holding)</h3>
    <div style="overflow-x: auto;">
      <table style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead><tr style="border-bottom: 1px solid var(--card-border);"><th style="padding:12px; color:var(--text-sub);">代码</th><th style="padding:12px; color:var(--text-sub);">交易时间</th><th style="padding:12px; color:var(--text-sub);">当前状态</th></tr></thead>
        <tbody>
          <tr style="border-bottom: 1px solid var(--card-border);">
            <td style="padding:12px;"><b>OXY</b></td><td style="padding:12px;">2026.02</td><td style="padding:12px; color: var(--profit); font-weight:bold;">持有</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--card-border);">
            <td style="padding:12px;"><b>NVO</b></td><td style="padding:12px;">2026.02</td><td style="padding:12px; color: var(--text-sub);">持有</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- 资产圆环图 (使用内联样式复用主页的视觉) -->
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px; margin-top: 20px; padding: 25px; background: rgba(0,0,0,0.2); border-radius: 12px; border: 1px solid rgba(255,255,255,0.05);">
      <div style="display: flex; align-items: center; gap: 30px;">
        <div style="width: 110px; height: 110px; border-radius: 50%; background: conic-gradient(var(--highlight) 0% 97.6%, var(--profit) 97.6% 100%); position: relative; display: flex; justify-content: center; align-items: center; box-shadow: 0 0 15px rgba(0,0,0,0.5);">
          <div style="position: absolute; width: 75px; height: 75px; background: var(--card-bg); border-radius: 50%;"></div>
          <div style="position: absolute; z-index: 1; font-size: 0.75rem; color: var(--text-sub); font-weight: bold; text-align: center; letter-spacing: 1px;">ASSETS</div>
        </div>
        <div style="display: flex; flex-direction: column; gap: 12px;">
          <div style="display: flex; align-items: center; gap: 8px; font-size: 0.95rem; color: var(--text-main);"><div style="width: 12px; height: 12px; border-radius: 3px; background: var(--highlight);"></div><div><b>OXY</b>: 97.6%</div></div>
          <div style="display: flex; align-items: center; gap: 8px; font-size: 0.95rem; color: var(--text-main);"><div style="width: 12px; height: 12px; border-radius: 3px; background: var(--profit);"></div><div><b>NVO</b>: 2.4%</div></div>
          <div style="font-size: 0.8rem; color: #666; margin-top:-5px;">Margin Cash: -$0.24</div>
        </div>
      </div>
      <div style="display: flex; flex-direction: column; gap: 15px; padding-left: 25px; border-left: 1px dashed rgba(255,255,255,0.15);">
        <div><div style="font-size: 0.85rem; color: var(--text-sub); margin-bottom: 4px;">绝对收益率 (Absolute)</div><div style="font-size: 1.5rem; font-weight: 900; font-family: monospace; color: var(--profit);">+46.75%</div></div>
        <div><div style="font-size: 0.85rem; color: var(--text-sub); margin-bottom: 4px;">年化收益率 (XIRR)</div><div style="font-size: 1.5rem; font-weight: 900; font-family: monospace; color: var(--profit);">+98.35%</div></div>
      </div>
    </div>
  </div>

  <div class="card">
    <h3 style="color:var(--text-sub); margin-bottom:10px;">🏁 已平仓 (Closed)</h3>
    <div style="overflow-x: auto;">
      <table style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead><tr style="border-bottom: 1px solid var(--card-border);"><th style="padding:12px; color:var(--text-sub);">代码</th><th style="padding:12px; color:var(--text-sub);">盈亏 %</th><th style="padding:12px; color:var(--text-sub);">状态</th></tr></thead>
        <tbody>
          <tr style="border-bottom: 1px solid var(--card-border);"><td style="padding:12px;"><b>AAL</b></td><td style="padding:12px; color: var(--profit); font-weight:bold;">+21.15%</td><td style="padding:12px;">已清仓</td></tr>
          <tr style="border-bottom: 1px solid var(--card-border);"><td style="padding:12px;"><b>GOOGL</b></td><td style="padding:12px; color: var(--profit); font-weight:bold;">+18.09%</td><td style="padding:12px;">已清仓</td></tr>
          <tr style="border-bottom: 1px solid var(--card-border);"><td style="padding:12px;"><b>TSLA</b></td><td style="padding:12px; color: var(--profit); font-weight:bold;">+8.47%</td><td style="padding:12px;">已清仓</td></tr>
          <tr style="border-bottom: 1px solid var(--card-border);"><td style="padding:12px;"><b>UNH</b></td><td style="padding:12px; color: var(--profit); font-weight:bold;">+0.84%</td><td style="padding:12px;">已清仓</td></tr>
          <tr style="border-bottom: 1px solid var(--card-border);"><td style="padding:12px;"><b>NKE</b></td><td style="padding:12px; color: var(--loss); font-weight:bold;">-5.81%</td><td style="padding:12px;">已清仓</td></tr>
          <tr style="border-bottom: 1px solid var(--card-border);"><td style="padding:12px;"><b>DJT</b></td><td style="padding:12px; color: var(--loss); font-weight:bold;">-8.29%</td><td style="padding:12px;">已清仓</td></tr>
          <tr style="border-bottom: 1px solid var(--card-border);"><td style="padding:12px;"><b>XYZ</b></td><td style="padding:12px; color: var(--loss); font-weight:bold;">-8.80%</td><td style="padding:12px;">已清仓</td></tr>
          <tr><td style="padding:12px;"><b>HOOD</b></td><td style="padding:12px; color: var(--loss); font-weight:bold;">-18.51%</td><td style="padding:12px;">已清仓</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</BaseLayout>