---
import TrendBackground from '../components/TrendBackground.astro';
import DragonDashboard from '../components/DragonDashboard.astro';
import { getCollection, render } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);

// --- 核心修复：定义 currentPath 变量，解决导航栏报错 ---
const currentPath = Astro.url.pathname;
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Lotus-eater | 交易思考</title>
    <link rel="icon" type="image/png" href="/favicon.png?v=2" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
      :root {
        --text-main: #e0e0e0; --text-sub: #b0b3b8;
        --card-bg: rgba(22, 26, 30, 0.85); --card-border: rgba(255, 255, 255, 0.1);
        --highlight: #2962ff; --profit: #00c853; --loss: #ff3d00;
        --nav-bg: rgba(11, 14, 17, 0.9);
      }
      body.light-mode {
        --text-main: #333333; --text-sub: #666666;
        --card-bg: rgba(255, 255, 255, 0.85); --card-border: rgba(0, 0, 0, 0.1);
        --highlight: #0052cc; --profit: #00796b; --loss: #d32f2f;
        --nav-bg: rgba(240, 242, 245, 0.9);
      }
      body { margin: 0; padding-top: 80px; font-family: 'Segoe UI', Roboto, sans-serif; color: var(--text-main); background-color: #0b0e11; transition: background-color 0.3s; padding-bottom: 200px; overflow-x: hidden; }
      body.light-mode { background-color: #f0f2f5; }

      .container { max-width: 850px; margin: 0 auto; padding: 20px; position: relative; z-index: 1; }
      section { min-height: 40vh; display: flex; flex-direction: column; justify-content: center; margin-bottom: 60px; }
      
      .card { background: var(--card-bg); backdrop-filter: blur(10px); border: 1px solid var(--card-border); border-radius: 16px; padding: 30px; margin-bottom: 20px; transition: transform 0.3s; }
      .card:hover { border-color: rgba(255,255,255,0.2); }
      .card h2 { border-bottom: 2px solid var(--highlight); display: inline-block; padding-bottom: 5px; margin-top: 0; color: var(--text-main); font-size: 1.5rem; }
      p { line-height: 1.8; color: var(--text-sub); font-size: 1.05rem; }

      .pinned-entry {
        display: flex; align-items: center; gap: 15px;
        background: linear-gradient(135deg, rgba(41, 98, 255, 0.1), rgba(41, 98, 255, 0.05));
        border: 1px solid rgba(41, 98, 255, 0.3); border-radius: 12px; padding: 20px;
        cursor: pointer; transition: all 0.2s; margin-bottom: 30px; text-decoration: none;
      }
      .pinned-entry:hover { background: linear-gradient(135deg, rgba(41, 98, 255, 0.2), rgba(41, 98, 255, 0.1)); transform: translateY(-2px); box-shadow: 0 5px 15px rgba(41, 98, 255, 0.15); }
      .pinned-icon { font-size: 2rem; color: var(--highlight); }
      .pinned-content { flex: 1; }
      .pinned-title { font-size: 1.1rem; font-weight: bold; color: var(--text-main); margin-bottom: 5px; }
      .pinned-desc { font-size: 0.9rem; color: var(--text-sub); }
      .pinned-arrow { color: var(--text-sub); }

      .crypto-item { display: flex; align-items: center; justify-content: space-between; background: rgba(0,0,0,0.2); padding: 12px; border-radius: 8px; margin-bottom: 10px; gap: 15px; }
      .crypto-info { display: flex; align-items: center; gap: 10px; color: var(--text-main); font-weight: 500; width: 80px; flex-shrink: 0; }
      .crypto-info i { width: 20px; text-align: center; font-size: 1.2rem; }
      .crypto-addr-container { flex-grow: 1; }
      .crypto-addr { font-family: monospace; color: var(--text-sub); font-size: 0.85rem; opacity: 0.8; word-break: break-all; line-height: 1.4; }
      .btn-copy { flex-shrink: 0; background: rgba(255,255,255,0.1); border: 1px solid var(--card-border); color: var(--text-main); padding: 6px 12px; border-radius: 6px; cursor: pointer; font-size: 0.8rem; transition: all 0.2s; white-space: nowrap; }
      .btn-copy:hover { background: var(--highlight); color: white; border-color: var(--highlight); }

      .feed-container { margin-top: 30px; border-top: 1px solid var(--card-border); padding-top: 20px; }
      .feed-post { margin-bottom: 30px; padding-bottom: 30px; border-bottom: 1px dashed rgba(255,255,255,0.1); }
      .feed-post:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
      .post-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 15px; }
      .post-title { margin: 0; font-size: 1.3rem; color: var(--highlight); font-weight: bold; text-decoration: none; }
      .post-date { font-size: 0.85rem; color: var(--text-sub); font-family: monospace; }
      .btn-more { display: inline-block; margin-top: 15px; padding: 8px 20px; border: 1px solid var(--highlight); color: var(--highlight); border-radius: 20px; text-decoration: none; font-size: 0.9rem; transition: all 0.2s; }
      .btn-more:hover { background: var(--highlight); color: white; }
      
      .prose { font-size: 1rem; line-height: 1.8; color: var(--text-sub); }
      .prose p { margin-top: 0; margin-bottom: 1em; }
      .prose strong { color: var(--text-main); font-weight: 600; }

      .table-wrapper { overflow-x: auto; }
      table { width: 100%; border-collapse: collapse; white-space: nowrap; font-size: 0.95rem; table-layout: fixed; }
      th, td { text-align: left; padding: 12px 8px; border-bottom: 1px solid var(--card-border); overflow: hidden; text-overflow: ellipsis; }
      th:nth-child(1), td:nth-child(1) { width: 30%; } th:nth-child(2), td:nth-child(2) { width: 35%; } th:nth-child(3), td:nth-child(3) { width: 35%; }
      th { color: var(--text-sub); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px; }
      .profit { color: var(--profit); font-weight: bold; } .loss { color: var(--loss); font-weight: bold; } .flat { color: var(--text-sub); }

      /* 重构的图表与统计区域 */
      .portfolio-dashboard {
        display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px;
        margin-top: 20px; padding: 25px; background: rgba(0,0,0,0.2); border-radius: 12px; border: 1px solid rgba(255,255,255,0.05);
      }
      .chart-left { display: flex; align-items: center; gap: 30px; }
      .donut-chart { 
        width: 110px; height: 110px; border-radius: 50%; 
        /* 修改这里：PSQ 蓝色 97.02%, NVO 绿色 2.08%, SQQQ 橙色 0.90% */
        background: conic-gradient(var(--highlight) 0% 97.02%, var(--profit) 97.02% 99.10%, #ff9800 99.10% 100%); 
        position: relative; display: flex; justify-content: center; align-items: center; 
        box-shadow: 0 0 15px rgba(0,0,0,0.5);
      }
      .donut-chart::after { content: ""; position: absolute; width: 75px; height: 75px; background: var(--card-bg); border-radius: 50%; }
      .chart-text { position: absolute; z-index: 1; font-size: 0.75rem; color: var(--text-sub); font-weight: bold; text-align: center; letter-spacing: 1px;}
      .chart-legend { display: flex; flex-direction: column; gap: 12px; }
      .legend-item { display: flex; align-items: center; gap: 8px; font-size: 0.95rem; color: var(--text-main);}
      .dot { width: 12px; height: 12px; border-radius: 3px; }
      .dot-psq { background: var(--highlight); }   /* PSQ 蓝色 */
      .dot-nvo { background: var(--profit); }      /* NVO 绿色 */
      .dot-sqqq { background: #ff9800; }           /* SQQQ 橙色 */
      
      .chart-stats {
        display: flex; flex-direction: column; gap: 15px;
        padding-left: 25px; border-left: 1px dashed rgba(255,255,255,0.15);
      }
      .stat-item .stat-label { font-size: 0.85rem; color: var(--text-sub); margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.5px;}
      .stat-item .stat-value { font-size: 1.5rem; font-weight: 900; font-family: 'Courier New', monospace; }

      /* --- 导航栏样式 --- */
      .navbar { position: fixed; top: 0; left: 0; width: 100%; height: 70px; background: var(--nav-bg); backdrop-filter: blur(10px); border-bottom: 1px solid var(--card-border); z-index: 1000; display: flex; align-items: center; padding: 0 20px; box-sizing: border-box; justify-content: space-between; }
      .nav-user { display: flex; align-items: center; gap: 10px; text-decoration: none; color: inherit; flex-shrink: 0; }
      .avatar { width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, #2962ff, #ff3d00); display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; }
      .username { font-weight: bold; font-size: 1.1rem; }
      
      .nav-menu { display: flex; gap: 25px; align-items: center; justify-content: center; flex: 1; }
      .nav-link { color: var(--text-sub); text-decoration: none; font-size: 0.95rem; font-weight: 500; transition: all 0.2s; display: flex; align-items: center; gap: 6px; padding-bottom: 4px; border-bottom: 2px solid transparent; }
      .nav-link:hover { color: var(--text-main); }
      .nav-link.active { color: var(--highlight); border-bottom-color: var(--highlight); }

      .nav-controls { display: flex; gap: 10px; flex-shrink: 0; }
      .btn-toggle { background: transparent; border: 1px solid var(--card-border); color: var(--text-main); padding: 5px 12px; border-radius: 20px; cursor: pointer; display: flex; gap: 5px; align-items: center; transition: all 0.2s; white-space: nowrap; }
      .btn-toggle:hover { background: rgba(255,255,255,0.1); }
      .btn-toggle.active { background: var(--highlight); color: white; border-color: var(--highlight); }

      /* === 📱 移动端 App 级适配 === */
      @media (max-width: 768px) {
        body { padding-top: 60px; padding-bottom: 120px; }
        .container { padding: 15px 10px; }
        .card { padding: 20px 15px; border-radius: 12px; }
        h1 { font-size: 1.8rem !important; }
        .card h2 { font-size: 1.3rem; }
        
        /* 顶部保留头像和明暗开关 */
        .navbar { height: 60px; padding: 0 15px; }
        .username { display: none; } /* 隐藏名字留出空间 */
        
        /* 核心魔法：变成【手机 App 底部导航栏】 */
        .nav-menu {
          position: fixed; bottom: 0; left: 0; width: 100%; height: 65px;
          background: rgba(15, 18, 22, 0.98); backdrop-filter: blur(15px);
          border-top: 1px solid var(--card-border);
          display: flex; flex-direction: row; justify-content: flex-start;
          overflow-x: auto; overflow-y: hidden; padding: 0 10px; gap: 5px;
          -webkit-overflow-scrolling: touch; z-index: 1001;
        }
        .nav-menu::-webkit-scrollbar { display: none; }
        .nav-link {
          flex-direction: column; justify-content: center; min-width: 65px;
          font-size: 0.75rem; gap: 4px; padding: 0; border-bottom: none !important;
        }
        .nav-link i { font-size: 1.2rem; }
        .nav-link span { display: block; }
        .nav-link.active { 
          border-top: 2px solid var(--highlight); 
          color: var(--highlight); 
          background: rgba(41, 98, 255, 0.1); 
          border-radius: 8px 8px 0 0; 
        }

        /* 战绩页：图表变竖向排版 */
        .portfolio-dashboard { flex-direction: column; align-items: stretch; padding: 15px; gap: 20px; }
        .chart-left { width: 100%; justify-content: center; gap: 20px; }
        .chart-stats { 
          width: 100%; flex-direction: row; justify-content: space-around; 
          padding-left: 0; border-left: none; border-top: 1px dashed var(--card-border); padding-top: 15px; 
        }
        .stat-item .stat-value { font-size: 1.2rem; }

        /* 赞助页：超长钱包地址换行与按钮撑满 */
        .crypto-item { flex-direction: column; align-items: stretch; gap: 10px; }
        .crypto-info { width: 100%; }
        .btn-copy { width: 100%; text-align: center; margin-left: 0; }
        
        /* 首页：置顶卡片适配 */
        .pinned-entry { flex-direction: column; align-items: flex-start; gap: 10px; padding: 15px; }
        .pinned-icon { display: none; }
      }

      #vignette-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 800; background: radial-gradient(circle, transparent 50%, black 120%); opacity: 0; transition: opacity 0.1s linear; }
    </style>
  </head>
  <body>
    <TrendBackground />
    <div id="dragon-global-wrapper" style="transition: opacity 0.3s;">
      <DragonDashboard />
    </div>
    <div id="vignette-overlay"></div>

    <nav class="navbar">
      <a href="/" class="nav-user"><div class="avatar">L</div><div class="username">Lotuseater</div></a>
      <div class="nav-menu">
        <a href="/" class={currentPath === '/' ? 'nav-link active' : 'nav-link'}><i class="fas fa-home"></i> <span>首页</span></a>
        <a href="/portfolio" class="nav-link"><i class="fas fa-chart-pie"></i> <span>战绩</span></a>
        <a href="/opinions" class="nav-link"><i class="fas fa-lightbulb"></i> <span>观点</span></a>
        <a href="/blog" class="nav-link"><i class="fas fa-archive"></i> <span>归档</span></a>
        <a href="/sponsor" class="nav-link"><i class="fas fa-bolt"></i> <span>充电</span></a>
        <a href="/friends" class="nav-link"><i class="fas fa-link"></i> <span>友链</span></a>
        <a href="/about" class="nav-link"><i class="fas fa-user"></i> <span>关于</span></a>
      </div>
      <div class="nav-controls">
        <button class="btn-toggle" onclick="toggleTheme()" id="btn-theme"><i class="fas fa-moon"></i></button>
        <button class="btn-toggle active" onclick="toggleChart()" id="btn-chart"><i class="fas fa-chart-line"></i></button>
      </div>
    </nav>

    <div class="container">
      
      <section>
        <div class="card">
          <h1>简介 (Intro)</h1>
          <p>这里是 Lotus-eater 的个人交易记录站，记录一些股票操作的记录，对各个公司股票的观点等。主要做美股市场，偶尔做期货合约和加密货币。</p>
          <p>我认为之前亏损太多，很大一部分原因就是复盘做的太少，对很多公司和交易的思考缺乏准确的记录。所以计划在这里记录平常的思考，和每次股票的买入卖出时的想法。<br>写下来主要是为了<b>以此为镜，让自己更能理清逻辑</b>。</p>
        </div>
      </section>

      <section>
        <div class="card">
          <h2>📝 个人记录 (Records)</h2>
          
          <a href="/opinions" class="pinned-entry">
            <div class="pinned-icon"><i class="fas fa-search-dollar"></i></div>
            <div class="pinned-content">
              <div class="pinned-title">我的观点 (Stock Opinions)</div>
              <div class="pinned-desc">持续更新对各种标的的评级与分析。</div>
            </div>
            <div class="pinned-arrow"><i class="fas fa-chevron-right"></i></div>
          </a>

          <div class="feed-container">
            <h3 style="font-size:1rem; color:var(--text-sub); margin-bottom:25px;">📅 最新记录 (Latest)</h3>
            
            {sortedPosts.slice(0, 3).map(async (post) => {
              const { Content } = await render(post);
              return (
                <div class="feed-post">
                  <div class="post-header">
                    <a href={`/blog/${post.id}`} class="post-title">{post.data.title}</a>
                    <span class="post-date">{post.data.pubDate.toLocaleDateString('zh-CN')}</span>
                  </div>
                  <div class="post-body prose">
                    <Content />
                  </div>
                </div>
              );
            })}
          </div>

          <div style="text-align: center; margin-top: 20px;">
            <a href="/blog" class="btn-more">查看所有历史记录 <i class="fas fa-arrow-right"></i></a>
          </div>
        </div>
      </section>

      <section>
        <div class="card">
          <h2>📊 交易战绩 (Trading)</h2>
          
          <h3 style="color:var(--text-sub); margin-bottom:10px; margin-top:20px;">⏳ 2026.05.30 持仓 (Holding)</h3>
          <div class="table-wrapper">
            <table>
              <thead><tr><th>代码</th><th>建仓时间</th><th>当前状态</th></tr></thead>
              <tbody>
                <tr><td><b>SATG</b></td><td>2026.05</td><td class="flat">持有</td></tr>
                <tr><td><b>SATL</b></td><td>2026.05</td><td class="flat">持有</td></tr>
                <tr><td><b>NVO</b></td><td>2026.02</td><td class="flat">持有</td></tr>
              </tbody>
            </table>
          </div>

          <div class="portfolio-dashboard">
            <div class="chart-left">
              <div class="donut-chart"><div class="chart-text">ASSETS</div></div>
              <div class="chart-legend">
                <div class="legend-item"><div class="dot dot-psq"></div><div><b>SATG</b>: 97.17%</div></div>
                <div class="legend-item"><div class="dot dot-psq"></div><div><b>SATL</b>: 2.38%</div></div>
                <div class="legend-item"><div class="dot dot-nvo"></div><div><b>NVO</b>: 0.45%</div></div>
              </div>
            </div>
            
            <div class="chart-stats">
              <div class="stat-item">
                <div class="stat-label">绝对收益率 (Absolute)</div>
                <div class="stat-value profit">+137.66%</div>
              </div>
              <div class="stat-item">
                <div class="stat-label">年化收益率 (XIRR)</div>
                <div class="stat-value profit">+186.31%</div>
              </div>
            </div>
          </div>

          <h3 style="color:var(--text-sub); margin-bottom:10px; margin-top:30px;">🏁 已平仓 (Closed)</h3>
          <div class="table-wrapper">
            <table>
              <thead><tr><th>代码</th><th>盈亏 %</th><th>状态</th></tr></thead>
              <tbody>
                <tr><td><b>MUU</b></td><td class="profit">+36.75%</td><td>已清仓</td></tr>
                <tr><td><b>FLNC</b></td><td class="profit">+23.60%</td><td>已清仓</td></tr>
                <tr><td><b>AAL</b></td><td class="profit">+21.15%</td><td>已清仓</td></tr>
                <tr><td><b>GOOGL</b></td><td class="profit">+19.46%</td><td>已清仓</td></tr>
                <tr><td><b>OXY</b></td><td class="profit">+16.70%</td><td>已清仓</td></tr>
                <tr><td><b>SCO</b></td><td class="profit">+10.23%</td><td>已清仓</td></tr>
                <tr><td><b>CRCL</b></td><td class="profit">+8.92%</td><td>已清仓</td></tr>
                <tr><td><b>TSLA</b></td><td class="profit">+8.47%</td><td>已清仓</td></tr>
                <tr><td><b>UNH</b></td><td class="profit">+0.84%</td><td>已清仓</td></tr>
                <tr><td><b>PSQ</b></td><td class="profit">+0.25%</td><td>已清仓</td></tr>
                <tr><td><b>NKE</b></td><td class="loss">-5.81%</td><td>已清仓</td></tr>
                <tr><td><b>DJT</b></td><td class="loss">-8.29%</td><td>已清仓</td></tr>
                <tr><td><b>XYZ</b></td><td class="loss">-8.80%</td><td>已清仓</td></tr>
                <tr><td><b>UVIX</b></td><td class="loss">-15.77%</td><td>已清仓</td></tr>
                <tr><td><b>HOOD</b></td><td class="loss">-18.51%</td><td>已清仓</td></tr>
                <tr><td><b>SQQQ</b></td><td class="loss">-28.04%</td><td>已清仓</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section>
        <div class="card">
          <h2>⚡ 赞助 (Support)</h2>
          <p style="margin-bottom: 20px;">如果我的记录对你有帮助，欢迎投喂一点燃料：</p>
          <div class="crypto-item"><div class="crypto-info"><i class="fab fa-monero" style="color:#f26822"></i> XMR</div><div class="crypto-addr-container"><div class="crypto-addr" id="addr-xmr">85PxQVWoYHfWgKGEmH8ncJTmbdLSHvmBYWvxfMScgpeBJuUQ4yDg8xoPbfyUQvuaSNWw6psNbJubeAi5PDa22qPLUiYCQ4P</div></div><button class="btn-copy" onclick="copyAddress('addr-xmr', this)"><i class="far fa-copy"></i> 复制</button></div>
          <div class="crypto-item"><div class="crypto-info"><i class="fas fa-cube" style="color:#00ffbd"></i> SOL</div><div class="crypto-addr-container"><div class="crypto-addr" id="addr-sol">FVJHLtGDESQasGozYXw7xufbbe2tbAW7vWAhGE4pjqzS</div></div><button class="btn-copy" onclick="copyAddress('addr-sol', this)"><i class="far fa-copy"></i> 复制</button></div>
          <div class="crypto-item"><div class="crypto-info"><i class="fab fa-ethereum" style="color:#627eea"></i> ETH</div><div class="crypto-addr-container"><div class="crypto-addr" id="addr-eth">0x935C5D4086e44239bff110f0623c97E7D7c55824</div></div><button class="btn-copy" onclick="copyAddress('addr-eth', this)"><i class="far fa-copy"></i> 复制</button></div>
          <div class="crypto-item"><div class="crypto-info"><i class="fas fa-network-wired" style="color:#f3ba2f"></i> BSC</div><div class="crypto-addr-container"><div class="crypto-addr" id="addr-bsc">0x6A970263301Ac793B42c0fB7d11118051C9DC96C</div></div><button class="btn-copy" onclick="copyAddress('addr-bsc', this)"><i class="far fa-copy"></i> 复制</button></div>
        </div>
      </section>

    <!-- 友链展示区 (首页精简版) -->
      <section>
       <div class="card">
        <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 20px;">
        <h2 style="margin: 0;">🔗 友链 (Friends)</h2>
        <a href="/friends" style="font-size: 0.9rem; color: var(--text-sub); text-decoration: none; transition: color 0.2s;">查看更多 <i class="fas fa-angle-right"></i></a>
