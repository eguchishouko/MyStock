---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="友情链接">
  <div class="card">
    <h1 style="margin-top:0;">🔗 友链 (Friends)</h1>
    <p>我还能够再次在市场上，在市场这个世界上战斗下去吗？</p>
  </div>

  <!-- 友链列表 (占位符) -->
  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 20px; margin-bottom: 40px;">
    
    <a href="#" class="friend-card">
      <div class="friend-avatar">U</div>
      <div class="friend-info">
        <div class="friend-name">Unknown Trader</div>
        <div class="friend-desc">Waiting for someone...</div>
      </div>
    </a>

  </div>

  <!-- 申请友链说明 -->
  <div class="card">
    <h2 style="border-bottom: 2px solid var(--highlight); display: inline-block; padding-bottom: 5px; margin-top: 0;">申请友链</h2>
    <p>欢迎与我交换友链！</p>
    <p style="background: rgba(0,0,0,0.3); padding: 15px; border-radius: 8px; font-family: monospace; border-left: 3px solid var(--highlight);">
      请按如下格式提供信息，并在下方留言板留言：<br><br>
      博客名：Lotuseater的交易记录站<br>
      简介：一个普通非专业交易员的股票交易记录<br>
      链接：https://lotuseater.xyz<br>
      图标：https://lotuseater.xyz/favicon.png
    </p>
    
    <!-- 留言板占位符 -->
    <div style="margin-top: 30px; padding: 30px; border: 1px dashed var(--card-border); border-radius: 8px; text-align: center; color: var(--text-sub);">
      <i class="fas fa-comments" style="font-size: 2rem; margin-bottom: 10px; display: block; opacity: 0.5;"></i>
      [ 留言板评论系统 还没有做好 下次让AI写 ]
    </div>
  </div>

  <style>
    .friend-card {
      display: flex; align-items: center; gap: 15px;
      background: var(--card-bg); border: 1px solid var(--card-border);
      padding: 15px; border-radius: 12px; text-decoration: none; transition: transform 0.2s, border-color 0.2s;
    }
    .friend-card:hover { transform: translateY(-3px); border-color: var(--highlight); }
    .friend-avatar { width: 50px; height: 50px; border-radius: 50%; background: #444; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; font-weight: bold; color: white; flex-shrink: 0; }
    .friend-info { flex: 1; overflow: hidden; }
    .friend-name { color: var(--text-main); font-weight: bold; font-size: 1.1rem; margin-bottom: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .friend-desc { color: var(--text-sub); font-size: 0.85rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  </style>
</BaseLayout>